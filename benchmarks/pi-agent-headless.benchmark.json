{
  "schema_version": "cargo-link-workload/v1",
  "name": "pi-agent-headless",
  "target": "aarch64-apple-darwin",
  "profile": "release",
  "cargo_arguments": ["--package", "pi-agent-tui", "--bin", "pi-agent-headless"],
  "artifact": "{target}/{profile}/pi-agent-headless",
  "macho_file_type": 2,
  "stable_layout_cache_eligible": true,
  "deployment_target": "11.0",
  "incremental_mutation": {
    "path": "crates/pi-agent-tui/src/bin/pi-agent-headless.rs",
    "append": "\n// wild benchmark incremental-rebuild marker\n"
  },
  "runtime": {
    "arguments": [
      "--model",
      "benchmark-model",
      "--prompt",
      "benchmark startup check",
      "--cwd",
      "."
    ],
    "expected_exit": 2,
    "stderr_contains": "OPENROUTER_API_KEY must be supplied by the caller"
  },
  "goals": {
    "cold_wild_over_apple_max": 0.95,
    "incremental_wild_over_apple_max": 0.70
  }
}
