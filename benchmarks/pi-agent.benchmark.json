{
  "schema_version": "cargo-link-workload/v1",
  "name": "pi-agent",
  "target": "aarch64-apple-darwin",
  "profile": "release",
  "cargo_arguments": ["--package", "pi-agent-tui", "--bin", "pi-agent"],
  "artifact": "{target}/{profile}/pi-agent",
  "macho_file_type": 2,
  "incremental_mutation": {
    "path": "crates/pi-agent-tui/src/main.rs",
    "append": "\n// wild benchmark incremental-rebuild marker\n"
  },
  "runtime": {
    "arguments": ["--help"],
    "stdout_contains": "Usage: pi-agent"
  },
  "goals": {
    "cold_wild_over_apple_max": 1.05,
    "incremental_wild_over_apple_max": 0.75
  }
}
