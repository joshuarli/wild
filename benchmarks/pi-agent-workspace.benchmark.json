{
  "schema_version": "cargo-link-workload/v1",
  "name": "pi-agent-core-rs-workspace",
  "target": "aarch64-apple-darwin",
  "profile": "release",
  "cargo_arguments": ["--workspace"],
  "artifacts": [
    {
      "path": "{target}/{profile}/pi-agent-headless",
      "macho_file_type": 2,
      "runtime": {
        "arguments": [
          "--model",
          "benchmark-model",
          "--prompt",
          "benchmark startup check",
          "--cwd",
          "."
        ],
        "expected_exit": 2,
        "stderr_contains": "OPENROUTER_API_KEY must be supplied by the caller"
      }
    },
    {
      "path": "{target}/{profile}/pi-agent",
      "macho_file_type": 2,
      "runtime": {
        "arguments": ["--help"],
        "stdout_contains": "Usage: pi-agent"
      }
    }
  ],
  "incremental_mutation": {
    "path": "crates/pi-agent-tui/src/bin/pi-agent-headless.rs",
    "append": "\n// wild benchmark workspace incremental-rebuild marker\n"
  },
  "goals": {
    "cold_wild_over_apple_max": 1.05,
    "incremental_wild_over_apple_max": 0.75
  }
}
