{
  "schema_version": "cargo-link-workload/v1",
  "name": "cargo",
  "toolchain": "nightly-2026-07-24",
  "target": "aarch64-apple-darwin",
  "profile": "linker-stress",
  "cargo_arguments": ["--bin", "cargo"],
  "artifact": "{target}/{profile}/cargo",
  "macho_file_type": 2,
  "stable_layout_cache_eligible": false,
  "deployment_target": "11.0",
  "incremental_mutation": {
    "path": "src/bin/cargo/commands/search.rs",
    "replace_before": "min(100, limit",
    "replace_after": "min(101, limit"
  },
  "runtime": {
    "arguments": ["--version"],
    "stdout_contains": "cargo "
  },
  "goals": {
    "cold_wild_over_apple_max": 0.95,
    "incremental_wild_over_apple_max": 0.70
  }
}
