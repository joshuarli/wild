{
  "schema_version": "cargo-link-workload/v1",
  "name": "e",
  "target": "aarch64-apple-darwin",
  "profile": "release",
  "cargo_arguments": ["--bin", "e"],
  "artifact": "{target}/{profile}/e",
  "macho_file_type": 2,
  "stable_layout_cache_eligible": true,
  "deployment_target": "11.0",
  "incremental_mutation": {
    "path": "src/main.rs",
    "replace_before": "size > 5_000_000",
    "replace_after": "size > 5_000_001"
  },
  "runtime": {
    "arguments": ["--version"],
    "stdout_contains": "e "
  },
  "goals": {
    "cold_wild_over_apple_max": 0.95,
    "incremental_wild_over_apple_max": 0.70
  }
}
